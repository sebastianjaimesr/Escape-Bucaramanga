; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Escape de Bucaramanga"
config/description="Plataformas 2D de acción nocturna inspirado en Bucaramanga."
config/version="1.0.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.06, 0.04, 0.12, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

GameState="*res://scripts/systems/game_state.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
SceneTransition="*res://scripts/systems/scene_transition.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=900.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.1, 1)
